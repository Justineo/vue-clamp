+// Regenerate with: node scripts/generate-unit-graphemes.mjs [UCD directory] [--check]
+// A local directory contains VERSION-GraphemeBreakProperty.txt and
+// 13.0.0-UnicodeData.txt. Without one, download the pinned Unicode source files.
+import { createHash } from "node:crypto";
+import { readFile, writeFile } from "node:fs/promises";
+import { join } from "node:path";
+
+const inputs = [
+  {
+    version: "13.0.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "2bd3c5e2d62701ff81fb3ec318e179a4618cabb1493b1e0dd2b4e7e56c5437c4",
+  },
+  {
+    version: "13.0.0",
+    name: "UnicodeData.txt",
+    sha256: "bdbffbbfc8ad4d3a6d01b5891510458f3d36f7170422af4ea2bed3211a73e8bb",
+  },
+  {
+    version: "14.0.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "97e79f1f8d9cd76d120f2420381a01abc00a7c78a2aa583fa3f9627264a99742",
+  },
+  {
+    version: "15.0.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "5a0f8748575432f8ff95e1dd5bfaa27bda1a844809e17d6939ee912bba6568a1",
+  },
+  {
+    version: "15.1.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "a7e52eee647e52dc210b8719b4d7037276f4b353810293d69377fc46374cec3f",
+  },
+  {
+    version: "16.0.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "c29360bd6f7132811d701d29069541e827eb44bfc4c8fbde8c370d6982689dc1",
+  },
+  {
+    version: "17.0.0",
+    name: "GraphemeBreakProperty.txt",
+    sha256: "d6b51d1d2ae5c33b451b7ed994b48f1f4dc62b2272a5831e7fd418514a6bae89",
+  },
+];
+const directory = process.argv.slice(2).find((argument) => argument !== "--check");
+const sources = await Promise.all(
+  inputs.map(async ({ version, name, sha256 }) => {
+    const file = `${version}-${name}`;
+    const path = name === "UnicodeData.txt" ? name : `auxiliary/${name}`;
+    const bytes = directory
+      ? await readFile(join(directory, file))
+      : Buffer.from(
+          await (
+            await fetch(`https://www.unicode.org/Public/${version}/ucd/${path}`)
+          ).arrayBuffer(),
+        );
+    if (createHash("sha256").update(bytes).digest("hex") !== sha256) {
+      throw new Error(`Unexpected Unicode data: ${file}`);
+    }
+    return { version, name, text: bytes.toString("utf8") };
+  }),
+);
+
+// Only frozen, publicly assigned BMP characters are eligible. Unknown characters,
+// surrogate code units and platform-tailored private-use text stay native.
+const admitted = new Uint8Array(0x10000);
+const unicodeData = sources.find(({ name }) => name === "UnicodeData.txt");
+let first;
+for (const line of unicodeData.text.trim().split("\n")) {
+  const [hex, name, category] = line.split(";");
+  const end = Number.parseInt(hex, 16);
+  if (end >= admitted.length) break;
+  if (name.endsWith(", First>")) {
+    first = end;
+    continue;
+  }
+  const start = name.endsWith(", Last>") ? first : end;
+  first = undefined;
+  if (category !== "Cs" && category !== "Co") admitted.fill(1, start, end + 1);
+}
+
+// UAX #29: these classes break between every pair in this closed alphabet.
+// LV/LVT are safe because joining L/V/T are excluded. CR is excluded because
+// CR × LF; Extend, SpacingMark, Prepend, ZWJ and RI are excluded throughout.
+const independentClasses = new Set(["Other", "Control", "LF", "LV", "LVT"]);
+for (const { name, text } of sources) {
+  if (name !== "GraphemeBreakProperty.txt") continue;
+  for (const line of text.split("\n")) {
+    const data = line.split("#")[0].trim();
+    if (!data) continue;
+    const [range, property] = data.split(";").map((part) => part.trim());
+    if (independentClasses.has(property)) continue;
+    const [start, end = start] = range.split("..").map((hex) => Number.parseInt(hex, 16));
+    if (start < admitted.length) admitted.fill(0, start, Math.min(end + 1, admitted.length));
+  }
+}
+
+const escape = (point) => `\\u${point.toString(16).padStart(4, "0")}`;
+const ranges = [];
+for (let point = 0; point < admitted.length; point += 1) {
+  if (!admitted[point]) continue;
+  const start = point;
+  while (admitted[point + 1]) point += 1;
+  ranges.push(escape(start) + (point === start ? "" : `-${escape(point)}`));
+}
+const chunks = [];
+for (let index = 0; index < ranges.length; index += 5) {
+  chunks.push(ranges.slice(index, index + 5).join(""));
+}
+chunks[0] = "[^" + chunks[0];
+chunks[chunks.length - 1] += "]";
+const output = `// Generated by scripts/generate-unit-graphemes.mjs; do not edit the table.
+// Public BMP assignments from Unicode 13; independent graphemes across Unicode 13–17.
+// Whole-source validation is required: one excluded character delegates to Intl.Segmenter.
+// Unicode data © 1991–2026 Unicode, Inc. See ../UNICODE-LICENSE.txt.
+const nonUnitGrapheme = /* @__PURE__ */ new RegExp(
+  ${chunks.map((chunk) => JSON.stringify(chunk)).join(" +\n    ")},
+  "u",
+);
+
+export function isUnitGraphemeText(text: string): boolean {
+  return !nonUnitGrapheme.test(text);
+}
+`;
+const target = new URL("../packages/vue-clamp/src/unit-graphemes.ts", import.meta.url);
+if (process.argv.includes("--check")) {
+  if ((await readFile(target, "utf8")) !== output) throw new Error("Unit grapheme table is stale.");
+} else {
+  await writeFile(target, output);
+}
+console.log(
+  `${admitted.reduce((sum, point) => sum + point, 0)} characters, ${ranges.length} ranges`,
+);
